# ============================================================================
# MEDICHAIN BACKEND CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values. NEVER commit .env to GitHub.
# ============================================================================

# Environment & Server
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration
# Option A (Cloud PostgreSQL - Recommended):
# DATABASE_URL=postgresql://neondb_owner:<password>@<neon-host>/neondb?sslmode=require&connect_timeout=45
# Option B (Local PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medichain
# Option C (Local SQLite fallback for quick testing):
# DATABASE_URL=sqlite:///./medichain_demo.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medichain

# Google Gemini API Key
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
# When empty, MEDICHAIN uses the internal verified medical knowledge base and synthetic clinical engine.
GEMINI_API_KEY=

# CORS Configuration (comma-separated allowed origins or wildcard '*')
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,https://medichain-frontend.vercel.app,https://medichain.netlify.app

# Ephemeral File Upload Configuration (Files are automatically deleted after in-memory processing)
UPLOAD_TEMP_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg
