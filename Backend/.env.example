# MEDICHAIN Backend Environment Variables

# Server Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL with SQLite fallback for local demo testing)
# Example PostgreSQL URL: postgresql://postgres:postgres@localhost:5432/medichain
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medichain

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Google Gemini API Key for AI Health Assistant and Report Analysis
# When left empty, the application gracefully provides realistic synthetic demo responses
GEMINI_API_KEY=

# File Upload Configuration (Temporary Processing Only)
UPLOAD_TEMP_DIR=uploads
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

